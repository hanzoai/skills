{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "workspace",
  "category": "context",
  "description": "Detect workspace roots, packages, scripts, and dependency graphs",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "detect",
          "roots",
          "packages",
          "env",
          "scripts",
          "graph"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
