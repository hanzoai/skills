{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "computer",
  "category": "browser",
  "description": "Browser & desktop control via ZAP bridge (tabs, CDP, snapshot, social automation)",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "tabs",
          "navigate",
          "snapshot",
          "click",
          "type",
          "press",
          "screenshot",
          "evaluate",
          "social.sessions",
          "social.sync",
          "social.post"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
