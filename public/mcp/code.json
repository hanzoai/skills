{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "code",
  "category": "semantic",
  "description": "Search code, AST symbols, definitions, references, and diagnostics",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "search",
          "symbols",
          "definition",
          "references",
          "outline",
          "ast",
          "diagnostics"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
