{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "git",
  "category": "vcs",
  "description": "Git status, diff, log, commit, branch, checkout, push, and PR workflows",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "status",
          "diff",
          "log",
          "commit",
          "branch",
          "checkout",
          "push",
          "pr"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
