{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "tasks",
  "category": "tasks",
  "description": "Manage workspace and team tasks",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list",
          "add",
          "update",
          "complete",
          "assign"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
