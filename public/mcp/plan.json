{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "plan",
  "category": "planning",
  "description": "Create, update, and track step-by-step execution plans",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "create",
          "update",
          "show",
          "approve",
          "step"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
