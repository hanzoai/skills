{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "fetch",
  "category": "network",
  "description": "HTTP requests, markdown scraping, and OpenAPI discovery",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "get",
          "post",
          "head",
          "scrape",
          "markdown",
          "openapi"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
