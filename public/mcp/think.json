{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "think",
  "category": "reasoning",
  "description": "Structured reasoning, decomposition, critique, and verification",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "thought",
          "critic",
          "decompose",
          "verify",
          "hypothesis"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
