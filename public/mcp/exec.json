{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "exec",
  "category": "execution",
  "description": "Execute shell commands and manage background processes",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "run",
          "bg",
          "ps",
          "logs",
          "kill",
          "stdin",
          "wait"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
