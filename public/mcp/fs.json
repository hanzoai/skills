{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "fs",
  "category": "filesystem",
  "description": "Read, write, edit, patch, list, and manage files",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "edit",
          "list",
          "stat",
          "mkdir",
          "rm",
          "mv",
          "cp",
          "patch"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
