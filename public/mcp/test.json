{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "test",
  "category": "verification",
  "description": "Run test suites, single tests, watch mode, and coverage",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "run",
          "watch",
          "coverage",
          "single",
          "list"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
