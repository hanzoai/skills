{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "memory",
  "category": "brain",
  "description": "Durable SQLite + vector + graph memory (~/.hanzo/brain/brain.db)",
  "inputSchema": {
    "type": "object",
    "required": [
      "action"
    ],
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "recall",
          "store",
          "facts",
          "graph",
          "search",
          "forget"
        ]
      },
      "params": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
